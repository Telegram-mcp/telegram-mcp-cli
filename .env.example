# Telegram API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Pre-authenticated Session (Provide either TELEGRAM_SESSION or TELEGRAM_SESSION_PATH)
# Option A: String Session
TELEGRAM_SESSION=
# Option B: Direct path to a Telethon SQLite session file (.session)
# TELEGRAM_SESSION_PATH=/path/to/your.session

# Environment configuration
# Set to 'true' for Telegram Test Server (DC 2 sandbox)
# Set to 'false' for Production Telegram network
TELEGRAM_TEST_MODE=true

# Optional: Set to 'true' to bypass test/production mismatch protection
# TELEGRAM_IGNORE_ENV_MISMATCH=false

# Optional: Default target bot username for CLI operations
DEFAULT_TARGET_BOT=
